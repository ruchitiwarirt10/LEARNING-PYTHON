   "source": [
    "#### 1.Palindrom Or not--"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f4570427-945c-4a25-a166-f69f7e968338",
   "metadata": {},
   "source": [
    "##### -Without slicing-"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "9cd9af9a-1b02-4b80-b381-347387660d69",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter any string:  madam\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "madam is a Palindrome\n"
     ]
    }
   ],
   "source": [
    "s=input(\"Enter any string: \")\n",
    "rev=''\n",
    "for i in s:\n",
    "    rev=i+rev\n",
    "if s==rev:\n",
    "    print(s,\"is a Palindrome\")\n",
    "else:\n",
    "    print(s,\"is not a Palindrome\")"
   ]
  },
